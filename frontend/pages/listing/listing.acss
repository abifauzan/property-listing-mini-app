/* §3 Listing Page */
.listing-page {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding: 16rpx;
}

/* §3.2 Search + Toggle row directly under app bar */
.listing-page__toolbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: #FFFFFF;
  border: 1rpx solid #E5E5E5;
  padding: 16rpx;
  gap: 16rpx;

  position: sticky;
  top: 0;
  z-index: 10;
}

.listing-page__search-wrapper {
  flex: 1;
  min-width: 0;
}

/* §4.1 Container padding 16 → 32rpx */
.listing-page__content {
  margin-top: 16rpx;
}

/* §5 Grid View — 2 fixed columns */
.listing-page__grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 24rpx;
}

/* §5.2 Grid card width = (100% - gap) / 2 */
.listing-page__grid-item {
  width: calc(50% - 12rpx);
}
