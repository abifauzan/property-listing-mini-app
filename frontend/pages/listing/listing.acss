/* §3 Listing Page */
.listing-page {
  min-height: 100vh;
  background-color: var(--color-bg-gray);
  padding: 16rpx;
}

/* §3.2 Search + Toggle row directly under app bar */
.listing-page__toolbar {
  background-color: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-base);
  padding: 16rpx;

  position: sticky;
  top: 0;
  z-index: var(--z-sticky);
}

.listing-page__search-wrapper {
  flex: 1;
  min-width: 0;
}

/* §4.1 Container padding 16 → 32rpx */
.listing-page__content {
  margin-top: 16rpx;
}

/* §5 Grid View — 2 fixed columns */
.listing-page__grid {
  /* Utility classes handle layout */
}

/* §5.2 Grid card width = (100% - gap) / 2 */
.listing-page__grid-item {
  width: calc(50% - 12rpx);
}
