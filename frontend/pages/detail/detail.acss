/* §7 Detail Page */
.detail-page {
  width: 100%;
  min-height: 100vh;
  background-color: #FFFFFF;
}

.detail-page__content {
  padding-bottom: 0;
}

/* §7.2 Hero Image — full width, ~35-45% top viewport */
.detail-page__hero {
  width: 100%;
  height: 560rpx;
}

/* §7.3.1 Title + Price */
.detail-page__info {
  padding: 32rpx 32rpx 16rpx;
}

.detail-page__title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A1A;
  display: block;
  line-height: 1.3;
}

/* §0.7 Price: grey, smaller */
.detail-page__price {
  font-size: 32rpx;
  font-weight: 400;
  color: #666666;
  display: block;
  margin-top: 12rpx;
}

/* §7.3 Sections — consistent spacing */
.detail-page__section {
  padding: 16rpx 32rpx;
}

/* §0.3 Section headings: bold */
.detail-page__section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
  display: block;
  margin-bottom: 16rpx;
}

/* §7.3.2 Paragraph text: softer color */
.detail-page__text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.7;
  display: block;
  margin-bottom: 8rpx;
}

/* §7.4 Facilities — blue chips with white text */
.detail-page__facilities {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
}

.detail-page__facility-tag {
  background-color: #1677FF;
  border-radius: 16rpx;
  padding: 12rpx 24rpx;
}

.detail-page__facility-text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 500;
}

/* Bottom spacer for fixed button */
.detail-page__bottom-spacer {
  height: 160rpx;
}

/* §8 Fixed Bottom CTA Button */
.detail-page__book-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

/* §8.1 Pill/rounded large button */
.detail-page__book-btn {
  width: 100%;
  height: 96rpx;
  background-color: #1677FF;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-page__book-btn-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}
