/* §7 Detail Page */
.detail-page {
  width: 100%;
  min-height: 100vh;
  background-color: var(--color-surface);
}

.detail-page__content {
  padding-bottom: 0;
}

/* §7.2 Hero Image — full width, ~35-45% top viewport */
.detail-page__hero {
  width: 100%;
  height: 560rpx;
}

/* §7.3.1 Title + Price */
.detail-page__info {
  padding: 32rpx 32rpx 16rpx;
}

.detail-page__title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  display: block;
  line-height: 1.3;
}

/* §0.7 Price: grey, smaller */
.detail-page__price {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text-secondary);
  display: block;
  margin-top: 12rpx;
}

/* §7.3 Sections — consistent spacing */
.detail-page__section {
  padding: 16rpx 32rpx;
  font-weight: 700;
}

/* §0.3 Section headings: bold */
.detail-page__section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: 10rpx;
}

/* §7.3.2 Paragraph text: softer color */
.detail-page__text {
  font-size: 26rpx;
  color: var(--color-text-primary);
  line-height: normal;
  display: block;
  margin-bottom: 8rpx;
}

/* §7.4 Facilities — blue chips with white text */
.detail-page__facilities {
  /* Utility classes handle layout */
}

.detail-page__facility-tag {
  background-color: var(--color-brand);
  border-radius: var(--radius-base);
  padding: 4rpx 20rpx;
}

.detail-page__facility-text {
  font-size: 24rpx;
  color: var(--color-text-inverse);
  font-weight: 500;
}

/* Bottom spacer for fixed button */
.detail-page__bottom-spacer {
  height: 280rpx;
}

/* §8 Fixed Bottom CTA Button */
.detail-page__book-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 32rpx;
  padding-top: 60rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  background-color: var(--color-surface);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: var(--z-fixed);
}

/* §8.1 Pill/rounded large button */
.detail-page__book-btn {
  width: 100%;
  height: 96rpx;
  background-color: var(--color-brand);
  border-radius: 48rpx;
}

.detail-page__book-btn-text {
  font-size: 32rpx;
  font-weight: 400;
  color: var(--color-text-inverse);
}
