/* §2 About Page */
.about-page {
  width: 100%;
  min-height: 100vh;
  background-color: var(--color-bg-gray);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* §2.2 Content centered, upper-middle area */
.about-page__body {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* §2.3 Circular logo, ~80-100 size → 180rpx */
.about-page__logo {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  margin-bottom: 32rpx;
}

/* §2.4 Text block 60-70% width, centered, left-aligned text */
.about-page__text-block {
  width: 90%;
}

.about-page__title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  text-align: center;
  display: block;
  margin-bottom: 24rpx;
}

/* §2.4 Paragraph: left-aligned, comfortable line-height */
.about-page__description {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  text-align: left;
  margin-bottom: 24rpx;
  display: block;
}
