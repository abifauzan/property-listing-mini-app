.empty-state {
  padding: 80rpx 32rpx;
}

.empty-state__icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-state__message {
  font-size: 28rpx;
  color: var(--color-text-muted);
  text-align: center;
  line-height: 1.6;
}

.empty-state__retry {
  margin-top: 32rpx;
  padding: 16rpx 48rpx;
  background-color: var(--color-brand);
  border-radius: var(--radius-base);
}

.empty-state__retry-text {
  font-size: 28rpx;
  color: var(--color-text-inverse);
  font-weight: 500;
}
