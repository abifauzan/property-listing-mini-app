.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 32rpx;
}

.empty-state__icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-state__message {
  font-size: 28rpx;
  color: #999999;
  text-align: center;
  line-height: 1.6;
}

.empty-state__retry {
  margin-top: 32rpx;
  padding: 16rpx 48rpx;
  background-color: #1677FF;
  border-radius: 12rpx;
}

.empty-state__retry-text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
}
