/* Shimmer animation */
@keyframes shimmer {
  0% { background-position: -750rpx 0; }
  100% { background-position: 750rpx 0; }
}

.skeleton-shimmer {
  background: linear-gradient(90deg, var(--color-skeleton-base) 25%, var(--color-skeleton-shine) 50%, var(--color-skeleton-base) 75%);
  background-size: 750rpx 100%;
  animation: shimmer 1.5s infinite;
}

/* List skeleton — vertical card to match §4.2 */
.skeleton-list-item {
  display: flex;
  flex-direction: column;
  background-color: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-base);
  overflow: hidden;
  margin-bottom: 32rpx;
}

.skeleton-list-item__image {
  width: 100%;
  height: 380rpx;
}

.skeleton-list-item__content {
  padding: 24rpx 28rpx 28rpx;
}

.skeleton-list-item__title {
  height: 32rpx;
  width: 70%;
  border-radius: var(--radius-base);
}

.skeleton-list-item__price {
  height: 24rpx;
  width: 40%;
  border-radius: var(--radius-base);
  margin-top: 12rpx;
}

/* Grid skeleton — match §5 */
.skeleton-grid {
  /* Utility classes handle layout */
}

.skeleton-grid-item {
  width: calc(50% - 12rpx);
  background-color: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-base);
  overflow: hidden;
}

.skeleton-grid-item__image {
  width: 100%;
  height: 240rpx;
}

.skeleton-grid-item__content {
  padding: 20rpx 24rpx 24rpx;
}

.skeleton-grid-item__title {
  height: 28rpx;
  width: 80%;
  border-radius: var(--radius-base);
}

.skeleton-grid-item__price {
  height: 24rpx;
  width: 50%;
  border-radius: var(--radius-base);
  margin-top: 12rpx;
}

/* Detail skeleton — match §7 */
.skeleton-detail__hero {
  width: 100%;
  height: 560rpx;
}

.skeleton-detail__body {
  padding: 32rpx;
}

.skeleton-detail__title {
  height: 40rpx;
  width: 60%;
  border-radius: var(--radius-base);
}

.skeleton-detail__price {
  height: 32rpx;
  width: 35%;
  border-radius: var(--radius-base);
  margin-top: 20rpx;
}

.skeleton-detail__gallery {
  margin-top: 32rpx;
}

.skeleton-detail__thumb {
  width: 160rpx;
  height: 120rpx;
  border-radius: var(--radius-base);
  margin-right: 16rpx;
}

.skeleton-detail__desc-line {
  height: 24rpx;
  width: 100%;
  border-radius: var(--radius-base);
  margin-top: 16rpx;
}
