/* §4.2 List Card — Full width, vertical layout */
.property-card {
  display: flex;
  flex-direction: column;
  background-color: #FFFFFF;
  border: 1rpx solid #E5E5E5;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
}

/* §4.2 Top image: ~16:9 aspect, rounded top corners follow card radius */
.property-card__image {
  width: 100%;
  height: 380rpx;
}

/* §4.2 Text block under image */
.property-card__content {
  display: flex;
  flex-direction: column;
  padding: 24rpx 28rpx 28rpx;
}

/* §0.3 Card title: semi-bold/bold */
.property-card__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* §0.7 Price: grey, smaller, directly under title */
.property-card__price {
  font-size: 26rpx;
  font-weight: 400;
  color: #666666;
  margin-top: 8rpx;
  display: block;
}
