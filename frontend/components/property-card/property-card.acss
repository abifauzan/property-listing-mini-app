/* §4.2 List Card — Full width, vertical layout */
.property-card {
  background-color: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-base);
  margin-bottom: 50rpx;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.06);
  min-height: 520rpx;
}

/* §4.2 Top image: ~16:9 aspect, rounded top corners follow card radius */
.property-card__image-container {
  padding: 24rpx;
}

.property-card__image {
  width: 100%;
  height: 380rpx;
  border-radius: var(--radius-base);
  object-fit: cover;
}

/* §4.2 Text block under image */
.property-card__content {
  padding: 0 45rpx 45rpx;
  justify-content: flex-start;
}

/* §0.3 Card title: semi-bold/bold */
.property-card__title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* §0.7 Price: grey, smaller, directly under title */
.property-card__price {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
  display: block;
}
