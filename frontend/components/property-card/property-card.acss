/* §4.2 List Card — Full width, vertical layout */
.property-card {
  display: flex;
  flex-direction: column;
  background-color: #FFFFFF;
  border: 1rpx solid #E5E5E5;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.06);
  min-height: 520rpx;
}

/* §4.2 Top image: ~16:9 aspect, rounded top corners follow card radius */
.property-card__image-container {
  padding: 16rpx;
}

.property-card__image {
  width: 100%;
  height: 380rpx;
  border-radius: 8rpx;
  object-fit: cover;
}

/* §4.2 Text block under image */
.property-card__content {
  display: flex;
  flex-direction: column;
  padding: 24rpx 28rpx 28rpx;
  flex: 1;
  justify-content: flex-start;
}

/* §0.3 Card title: semi-bold/bold */
.property-card__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* §0.7 Price: grey, smaller, directly under title */
.property-card__price {
  font-size: 28rpx;
  font-weight: 400;
  color: #666666;
  margin-top: 8rpx;
  display: block;
}
