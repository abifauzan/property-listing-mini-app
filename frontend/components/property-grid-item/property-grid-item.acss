/* §5.2 Grid Card */
.property-grid-item {
  width: 100%;
  height: 520rpx;
  background-color: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-base);
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* §5.2 More square-ish ~4:3 image */
.property-grid-item__image-container {
  padding: 20rpx;
}

.property-grid-item__image {
  width: 100%;
  height: 300rpx;
  border-radius: var(--radius-base);
  object-fit: cover;
}

/* §5.2 Text block padding 12 */
.property-grid-item__content {
  padding: 0 20rpx 20rpx;
  justify-content: flex-start;
}

/* §5.2 Title can wrap up to 2 lines */
.property-grid-item__title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* §0.7 Price under title (grey) */
.property-grid-item__price {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
  display: block;
}
