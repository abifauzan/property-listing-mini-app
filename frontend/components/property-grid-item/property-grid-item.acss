/* §5.2 Grid Card */
.property-grid-item {
  width: 100%;
  height: 520rpx;
  background-color: #FFFFFF;
  border: 1rpx solid #E5E5E5;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
}

/* §5.2 More square-ish ~4:3 image */
.property-grid-item__image-container {
  padding: 20rpx;
}

.property-grid-item__image {
  width: 100%;
  height: 300rpx;
  border-radius: 8rpx;
  object-fit: cover;
}

/* §5.2 Text block padding 12 */
.property-grid-item__content {
  padding: 0 20rpx 20rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

/* §5.2 Title can wrap up to 2 lines */
.property-grid-item__title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* §0.7 Price under title (grey) */
.property-grid-item__price {
  font-size: 26rpx;
  font-weight: 400;
  color: #666666;
  margin-top: 8rpx;
  display: block;
}
