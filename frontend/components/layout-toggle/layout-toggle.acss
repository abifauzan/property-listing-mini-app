/* §3.2.2 Layout Toggle — square, matches input height */
.layout-toggle {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #FFFFFF;
  border: 1rpx solid #E5E5E5;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.layout-toggle__icon {
  width: 36rpx;
  height: 36rpx;
}
