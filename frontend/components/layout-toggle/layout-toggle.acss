/* §3.2.2 Layout Toggle — square, matches input height */
.layout-toggle {
  width: 76rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #F5F5F5;
  border: 1rpx solid #E5E5E5;
  flex-shrink: 0;
}

.layout-toggle__icon {
  width: 50rpx;
  height: 50rpx;
}
