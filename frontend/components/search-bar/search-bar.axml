<view class="search-bar">
  <input
    class="search-bar__input"
    type="text"
    value="{{value}}"
    placeholder="{{placeholder}}"
    placeholderStyle="color: #BBBBBB;"
    onInput="onInput"
    onConfirm="onConfirm"
    confirmType="search"
  />
  <view class="search-bar__clear" onTap="onClear" a:if="{{value && value.length > 0}}">
    <text class="search-bar__clear-text">✕</text>
  </view>
</view>
