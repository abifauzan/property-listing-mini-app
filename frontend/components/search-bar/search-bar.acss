/* §3.2.1 Search Input */
.search-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: #FFFFFF;
  border: 1rpx solid #E5E5E5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  height: 76rpx;
}

.search-bar__icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  margin-right: 12rpx;
}

.search-bar__icon-img {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.4;
}

.search-bar__input {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
  height: 76rpx;
  line-height: 76rpx;
}

.search-bar__clear {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.search-bar__clear-text {
  font-size: 24rpx;
  color: #999999;
}
