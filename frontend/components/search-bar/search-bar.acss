/* §3.2.1 Search Input */
.search-bar {
  height: 44rpx;
  gap: 12rpx;
}

.search-bar__input {
  flex: 1;
  font-size: 24rpx;
  color: var(--color-text-primary);
  background-color: var(--color-input-bg);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-base);
  padding: 12rpx 16rpx;
  height: 44rpx;
  line-height: 44rpx;
}

.search-bar__clear {
  width: 44rpx;
  height: 44rpx;
}

.search-bar__clear-text {
  font-size: 24rpx;
  color: var(--color-text-muted);
}
