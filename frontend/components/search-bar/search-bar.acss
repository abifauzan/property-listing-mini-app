/* §3.2.1 Search Input */
.search-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 44rpx;
  gap: 12rpx;
}

.search-bar__input {
  flex: 1;
  font-size: 24rpx;
  color: #1A1A1A;
  background-color: #EEEEEE;
  border: 1rpx solid #E5E5E5;
  padding: 12rpx 16rpx;
  height: 44rpx;
  line-height: 44rpx;
}

.search-bar__clear {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.search-bar__clear-text {
  font-size: 24rpx;
  color: #999999;
}
