# Environment Configuration Example
# Copy this file to .env and adjust values as needed

# Application environment (development, staging, production)
ENV=development

# Server port
PORT=8080

# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=property_listing
DB_SSLMODE=disable

# Path to properties JSON data file (for fallback/migration)
DATA_PATH=data/properties.json

# CORS allowed origin (use "*" for development, specific origin for production)
CORS_ALLOW_ORIGIN=*

# Log level (debug, info, warn, error)
LOG_LEVEL=info
