.property-grid-item {
  width: 100%;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.property-grid-item__image {
  width: 100%;
  height: 260rpx;
}

.property-grid-item__content {
  padding: 16rpx 20rpx 20rpx;
}

.property-grid-item__title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A1A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.property-grid-item__price {
  font-size: 24rpx;
  font-weight: 600;
  color: #FF6B35;
  margin-top: 8rpx;
  display: block;
}
