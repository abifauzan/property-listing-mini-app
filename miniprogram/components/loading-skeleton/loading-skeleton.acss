/* Shimmer animation */
@keyframes shimmer {
  0% { background-position: -750rpx 0; }
  100% { background-position: 750rpx 0; }
}

.skeleton-shimmer {
  background: linear-gradient(90deg, #F0F0F0 25%, #E0E0E0 50%, #F0F0F0 75%);
  background-size: 750rpx 100%;
  animation: shimmer 1.5s infinite;
}

/* List skeleton */
.skeleton-list-item {
  display: flex;
  flex-direction: row;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.skeleton-list-item__image {
  width: 240rpx;
  height: 200rpx;
  flex-shrink: 0;
}

.skeleton-list-item__content {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.skeleton-list-item__title {
  height: 32rpx;
  width: 70%;
  border-radius: 8rpx;
}

.skeleton-list-item__price {
  height: 28rpx;
  width: 40%;
  border-radius: 8rpx;
  margin-top: 16rpx;
}

/* Grid skeleton */
.skeleton-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
}

.skeleton-grid-item {
  width: 48%;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.skeleton-grid-item__image {
  width: 100%;
  height: 260rpx;
}

.skeleton-grid-item__content {
  padding: 16rpx 20rpx 20rpx;
}

.skeleton-grid-item__title {
  height: 28rpx;
  width: 80%;
  border-radius: 8rpx;
}

.skeleton-grid-item__price {
  height: 24rpx;
  width: 50%;
  border-radius: 8rpx;
  margin-top: 12rpx;
}

/* Detail skeleton */
.skeleton-detail__hero {
  width: 100%;
  height: 500rpx;
}

.skeleton-detail__body {
  padding: 32rpx;
}

.skeleton-detail__title {
  height: 40rpx;
  width: 60%;
  border-radius: 8rpx;
}

.skeleton-detail__price {
  height: 32rpx;
  width: 35%;
  border-radius: 8rpx;
  margin-top: 20rpx;
}

.skeleton-detail__gallery {
  display: flex;
  flex-direction: row;
  margin-top: 32rpx;
}

.skeleton-detail__thumb {
  width: 160rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
}

.skeleton-detail__desc-line {
  height: 24rpx;
  width: 100%;
  border-radius: 8rpx;
  margin-top: 16rpx;
}
