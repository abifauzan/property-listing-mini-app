.image-carousel {
  position: relative;
  width: 100%;
}

.image-carousel__swiper {
  width: 100%;
  height: 400rpx;
}

.image-carousel__image {
  width: 100%;
  height: 400rpx;
  border-radius: 12rpx;
}

.image-carousel__indicator {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 20rpx;
  padding: 6rpx 20rpx;
}

.image-carousel__indicator-text {
  font-size: 22rpx;
  color: #FFFFFF;
}
