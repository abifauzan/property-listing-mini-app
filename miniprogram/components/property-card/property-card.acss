.property-card {
  display: flex;
  flex-direction: row;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.property-card__image {
  width: 240rpx;
  height: 200rpx;
  flex-shrink: 0;
}

.property-card__content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 24rpx;
  min-width: 0;
}

.property-card__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.property-card__price {
  font-size: 28rpx;
  font-weight: 600;
  color: #FF6B35;
  margin-top: 12rpx;
}
