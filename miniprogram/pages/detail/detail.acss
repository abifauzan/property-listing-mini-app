.detail-page {
  min-height: 100vh;
  background-color: #FFFFFF;
}

.detail-page__content {
  padding-bottom: 0;
}

/* Hero Image */
.detail-page__hero {
  width: 100%;
  height: 500rpx;
}

/* Info Section */
.detail-page__info {
  padding: 32rpx 32rpx 16rpx;
}

.detail-page__title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A1A;
  display: block;
  line-height: 1.3;
}

.detail-page__price {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF6B35;
  display: block;
  margin-top: 12rpx;
}

/* Sections */
.detail-page__section {
  padding: 24rpx 32rpx;
}

.detail-page__section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
  margin-bottom: 16rpx;
}

.detail-page__text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
  display: block;
}

/* Facilities */
.detail-page__facilities {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
}

.detail-page__facility-tag {
  background-color: #F0F7FF;
  border: 1rpx solid #D6E8FF;
  border-radius: 8rpx;
  padding: 8rpx 24rpx;
}

.detail-page__facility-text {
  font-size: 24rpx;
  color: #1677FF;
  font-weight: 500;
}

/* Bottom spacer */
.detail-page__bottom-spacer {
  height: 140rpx;
}

/* Fixed Book Now Bar */
.detail-page__book-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.detail-page__book-btn {
  width: 100%;
  height: 88rpx;
  background-color: #1677FF;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-page__book-btn-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}
