.about-page {
  min-height: 100vh;
  background-color: #FFFFFF;
  padding-bottom: 40rpx;
}

.about-page__header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 32rpx 40rpx;
  background: linear-gradient(180deg, #F0F7FF 0%, #FFFFFF 100%);
}

.about-page__logo {
  width: 200rpx;
  height: 200rpx;
}

.about-page__content {
  padding: 0 40rpx;
}

.about-page__title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1A1A1A;
  text-align: center;
  display: block;
}

.about-page__divider {
  width: 80rpx;
  height: 6rpx;
  background-color: #1677FF;
  border-radius: 3rpx;
  margin: 24rpx auto 32rpx;
}

.about-page__description {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
  margin-bottom: 24rpx;
  display: block;
}

.about-page__features {
  margin-top: 40rpx;
  padding: 32rpx;
  background-color: #F8FAFC;
  border-radius: 16rpx;
}

.about-page__feature-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 0;
}

.about-page__feature-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  width: 48rpx;
  text-align: center;
}

.about-page__feature-text {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.about-page__footer {
  margin-top: 60rpx;
  text-align: center;
}

.about-page__version {
  font-size: 24rpx;
  color: #BBBBBB;
}
